# Copia este archivo a .env y ajusta los valores según tu entorno local.
# .env nunca se versiona (ver .gitignore).

# Cadena de conexión a PostgreSQL. Coincide con las credenciales de
# docker-compose.yml (usuario, contraseña y base de datos "filacero").
DATABASE_URL="postgresql://filacero:filacero@localhost:5432/filacero_db?schema=public"

# Secreto usado para firmar y verificar los JWT emitidos por /auth/login
# y /auth/register. Usa un valor largo y aleatorio en cualquier entorno
# que no sea tu máquina local (por ejemplo: openssl rand -hex 32).
JWT_SECRET="dev-secret-change-me"

# Puerto en el que escucha la API. Opcional: si se omite, usa 3000.
# PORT=3000
