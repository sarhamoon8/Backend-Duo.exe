# Copia este archivo a .env y ajusta los valores según tu entorno local.
# .env nunca se versiona (ver .gitignore).

# Cadena de conexión a PostgreSQL. Coincide con las credenciales de
# docker-compose.yml (usuario, contraseña y base de datos "filacero").
DATABASE_URL="postgresql://filacero:filacero@localhost:5432/filacero_db?schema=public"

# Secreto usado para firmar y verificar los JWT emitidos por /auth/login
# y /auth/register. Usa un valor largo y aleatorio en cualquier entorno
# que no sea tu máquina local (por ejemplo: openssl rand -hex 32).
JWT_SECRET="dev-secret-change-me"

# Puerto en el que escucha la API. Opcional: si se omite, usa 3000.
# PORT=3000

# RF-05 (notificaciones): se probaron Resend (en su plan gratis sin
# dominio verificado, solo entrega al correo del propio dueño de la
# cuenta), Brevo (su registro pidió tarjeta en todas las opciones) y
# Gmail por SMTP (puertos 465 y 587 ambos bloqueados de salida en
# Railway — "Connection timeout"). Lo que sí funciona es la API HTTP de
# Gmail (puerto 443, nunca bloqueado) con la misma cuenta, autenticada
# con OAuth2 en vez de una contraseña de aplicación:
#
# 1. Crea una cuenta de Gmail solo para el proyecto (ej.
#    filacero.notificaciones@gmail.com) y pégala en GMAIL_USER.
# 2. En console.cloud.google.com (mismo proyecto de GOOGLE_CLIENT_ID de
#    abajo): APIs y servicios → Biblioteca → habilita "Gmail API".
# 3. APIs y servicios → Credenciales → Crear credenciales → ID de
#    cliente de OAuth → tipo "Aplicación web" (uno NUEVO, distinto al de
#    "Continuar con Google" de abajo). En "URI de redireccionamiento
#    autorizados" agrega https://developers.google.com/oauthplayground.
#    Pega el Client ID y Client Secret en GMAIL_OAUTH_CLIENT_ID/SECRET.
# 4. En developers.google.com/oauthplayground: engranaje (arriba a la
#    derecha) → "Use your own OAuth credentials" → pega ese Client
#    ID/Secret. Autoriza el scope
#    https://www.googleapis.com/auth/gmail.send iniciando sesión con la
#    cuenta de GMAIL_USER. "Exchange authorization code for tokens" →
#    copia el "Refresh token" en GMAIL_REFRESH_TOKEN.
GMAIL_USER="filacero.notificaciones@gmail.com"
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# "Continuar con Google" (inicio de sesión y registro).
# 1. Entra a console.cloud.google.com → APIs y servicios → Credenciales.
# 2. Crear credenciales → ID de cliente de OAuth → tipo "Aplicación web".
# 3. En "Orígenes de JavaScript autorizados" agrega http://localhost:3001
#    (y el dominio real cuando se publique). No hace falta URI de redirección.
# 4. Pega aquí el ID de cliente (termina en .apps.googleusercontent.com).
#    El mismo valor lo usan el backend (verifica el token) y el frontend.
GOOGLE_CLIENT_ID=""

# Recuperar contraseña: el enlace del correo apunta a esta URL del frontend.
FRONTEND_URL="http://localhost:3001"
# SOLO desarrollo: escribe el enlace de recuperación en los logs del backend
# (útil si no configuraste Gmail). Déjalo en false en producción.
RECUPERACION_REGISTRAR_ENLACE="false"

# Token de SonarQube (http://localhost:9000 → My Account → Security →
# Generate Tokens, tipo "Global Analysis Token" para que sirva en los
# tres repos). Lo usa el servicio sonar-scanner de docker-compose.sonar.yml.
SONAR_TOKEN="sqa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
