# Copia este archivo a .env y ajusta los valores según tu entorno local.
# .env nunca se versiona (ver .gitignore).

# Cadena de conexión a PostgreSQL. Coincide con las credenciales de
# docker-compose.yml (usuario, contraseña y base de datos "filacero").
DATABASE_URL="postgresql://filacero:filacero@localhost:5432/filacero_db?schema=public"

# Secreto usado para firmar y verificar los JWT emitidos por /auth/login
# y /auth/register. Usa un valor largo y aleatorio en cualquier entorno
# que no sea tu máquina local (por ejemplo: openssl rand -hex 32).
JWT_SECRET="dev-secret-change-me"

# Puerto en el que escucha la API. Opcional: si se omite, usa 3000.
# PORT=3000

# RF-05 (notificaciones): se probaron Resend (en su plan gratis sin
# dominio verificado, solo entrega al correo del propio dueño de la
# cuenta) y Brevo (su registro pidió tarjeta en todas las opciones).
# Lo que de verdad no pide tarjeta ni aprobación de proveedor es Gmail
# SMTP con una cuenta dedicada al proyecto (no la personal):
#
# 1. Crea una cuenta de Gmail solo para el proyecto (ej.
#    filacero.notificaciones@gmail.com).
# 2. Activa la verificación en dos pasos en esa cuenta
#    (myaccount.google.com/security).
# 3. Genera una "contraseña de aplicación" en
#    myaccount.google.com/apppasswords (elige app "Correo" / "Otra").
# 4. Pega esa cuenta y esa contraseña de aplicación (NO la contraseña
#    normal de Gmail) aquí abajo.
GMAIL_USER="filacero.notificaciones@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
