# Copia este archivo a .env y ajusta los valores según tu entorno local.
# .env nunca se versiona (ver .gitignore).

# Cadena de conexión a PostgreSQL. Coincide con las credenciales de
# docker-compose.yml (usuario, contraseña y base de datos "filacero").
DATABASE_URL="postgresql://filacero:filacero@localhost:5432/filacero_db?schema=public"

# Secreto usado para firmar y verificar los JWT emitidos por /auth/login
# y /auth/register. Usa un valor largo y aleatorio en cualquier entorno
# que no sea tu máquina local (por ejemplo: openssl rand -hex 32).
JWT_SECRET="dev-secret-change-me"

# Puerto en el que escucha la API. Opcional: si se omite, usa 3000.
# PORT=3000

# RF-05 (notificaciones): API key de Brevo (https://www.brevo.com) para
# enviar las notificaciones por correo (turno creado, cancelado, etc.).
# Gratis hasta 300 correos/día sin tarjeta. Crea una cuenta, ve a
# SMTP & API > API Keys, genera una y pégala aquí.
#
# A diferencia de Resend, Brevo SÍ entrega a cualquier destinatario real
# sin necesidad de verificar un dominio propio (por eso se eligió sobre
# Resend) — necesario para que alguien externo (el profesor, un
# compañero) pueda probar la app con su propio correo.
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente que verá el usuario en el correo. Antes de usarlo, agrégalo
# y verifícalo en tu cuenta de Brevo (Senders, Domains & Dedicated IPs >
# Senders > Add a sender) — es solo confirmar ese correo por un enlace
# que te llega a él, no verificar un dominio DNS completo. El más fácil
# de verificar es un correo que ya controles (por ejemplo tu Gmail).
BREVO_FROM_EMAIL="tu-correo-verificado-en-brevo@gmail.com"
BREVO_FROM_NAME="FilaCero"
