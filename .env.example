# Copia este archivo a .env y ajusta los valores según tu entorno local.
# .env nunca se versiona (ver .gitignore).

# Cadena de conexión a PostgreSQL. Coincide con las credenciales de
# docker-compose.yml (usuario, contraseña y base de datos "filacero").
DATABASE_URL="postgresql://filacero:filacero@localhost:5432/filacero_db?schema=public"

# Secreto usado para firmar y verificar los JWT emitidos por /auth/login
# y /auth/register. Usa un valor largo y aleatorio en cualquier entorno
# que no sea tu máquina local (por ejemplo: openssl rand -hex 32).
JWT_SECRET="dev-secret-change-me"

# Puerto en el que escucha la API. Opcional: si se omite, usa 3000.
# PORT=3000

# RF-05 (notificaciones): API key de Resend (https://resend.com) para
# enviar las notificaciones por correo (turno creado, cancelado, etc.).
# Gratis hasta 100 correos/día sin tarjeta. Crea una cuenta, genera una
# API key en el dashboard y pégala aquí.
#
# Importante para pruebas: sin verificar un dominio propio en Resend,
# solo puedes enviar correos a la dirección con la que te registraste
# en Resend (no a cualquier email de usuario de la app). Para demos con
# varios usuarios reales haría falta verificar un dominio; para el
# entorno de desarrollo/académico basta con el correo del remitente.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente que verá el usuario en el correo. Con el plan gratuito sin
# dominio verificado, usa el dominio de pruebas de Resend:
RESEND_FROM_EMAIL="FilaCero <onboarding@resend.dev>"
