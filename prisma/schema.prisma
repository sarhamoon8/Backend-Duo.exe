// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String   @id @default(uuid())
  numeroDocumento String   @unique
  tipoDocumento   String
  nombres         String
  apellidos       String
  email           String   @unique
  password        String
  telefono        String?
  rol             Rol      @default(PACIENTE)
  creadoEn        DateTime @default(now())
  turnos          Turno[]
  listasEspera    ListaEspera[]
  notificaciones  Notificacion[]
}

enum Rol {
  PACIENTE
  FUNCIONARIO
  ADMIN
}

// RF-05: cada evento relevante del flujo de turnos genera un registro aquí
// (historial consultable desde /notificaciones/mis-notificaciones) y, en
// paralelo, un intento de envío por correo vía Resend. El envío de correo
// nunca bloquea el flujo que lo origina (ver EnviarNotificacionUseCase):
// si Resend falla o no hay API key configurada, igual queda el registro
// con estadoEnvio FALLIDA.
model Notificacion {
  id          String                    @id @default(uuid())
  usuario     Usuario                   @relation(fields: [usuarioId], references: [id])
  usuarioId   String
  tipo        TipoNotificacion
  titulo      String
  mensaje     String
  estadoEnvio EstadoEnvioNotificacion
  leida       Boolean                   @default(false)
  creadoEn    DateTime                  @default(now())

  @@index([usuarioId])
}

enum TipoNotificacion {
  TURNO_CREADO
  TURNO_CANCELADO
  TURNO_EN_CURSO
  TURNO_REASIGNADO
}

enum EstadoEnvioNotificacion {
  ENVIADA
  FALLIDA
}

// La institución de salud (EPS, IPS, centro médico). No forma parte del
// modelo relacional de 12 entidades documentado en PROJECT_CONTEXT.md,
// pero se mantiene como decisión ya tomada por el código: representa el
// nivel "institución", distinto de PuntoDispensacion ("sede física").
model EntidadMedica {
  id                 String              @id @default(uuid())
  nombre             String
  servicios          Servicio[]
  puntosDispensacion PuntoDispensacion[]
}

model Servicio {
  id                String        @id @default(uuid())
  codigoServicio    String        @unique
  nombre            String
  tiempoPromedioMin Int
  activo            Boolean       @default(true)
  entidad           EntidadMedica @relation(fields: [entidadId], references: [id])
  entidadId         String
  turnos            Turno[]
  listasEspera      ListaEspera[]
}

// Sede física de una EntidadMedica (PUNTO_DISPENSACION en el modelo
// relacional completo, sección 15.1 de PROJECT_CONTEXT.md).
model PuntoDispensacion {
  id                String       @id @default(uuid())
  entidad           EntidadMedica @relation(fields: [entidadId], references: [id])
  entidadId         String
  nombreSede        String
  direccion         String
  ciudad            String
  telefonoContacto  String?
  capacidadAtencion Int
  ventanillas       Ventanilla[]
  turnos            Turno[]
  inventario        Inventario[]
  listasEspera      ListaEspera[]
  profesionales     Profesional[]
}

// Profesional de salud (doctor) que atiende en una sede. Por ahora se carga
// con datos simulados mientras no exista la integración con el registro de
// profesionales de la EPS.
model Profesional {
  id                String            @id @default(uuid())
  registroMedico    String            @unique
  nombres           String
  apellidos         String
  especialidad      String
  activo            Boolean           @default(true)
  puntoDispensacion PuntoDispensacion @relation(fields: [puntoId], references: [id])
  puntoId           String
  creadoEn          DateTime          @default(now())
}

enum EstadoOperativoVentanilla {
  ACTIVA
  INACTIVA
}

model Ventanilla {
  id                String                    @id @default(uuid())
  puntoDispensacion PuntoDispensacion          @relation(fields: [puntoId], references: [id])
  puntoId           String
  numeroModulo      String
  estadoOperativo   EstadoOperativoVentanilla @default(ACTIVA)
  turnos            Turno[]

  @@unique([puntoId, numeroModulo])
}

model Turno {
  id                 String      @id @default(uuid())
  usuario            Usuario     @relation(fields: [usuarioId], references: [id])
  usuarioId          String
  servicio           Servicio    @relation(fields: [servicioId], references: [id])
  servicioId         String
  puntoDispensacion  PuntoDispensacion @relation(fields: [puntoId], references: [id])
  puntoId            String
  ventanilla         Ventanilla? @relation(fields: [ventanillaId], references: [id])
  ventanillaId       String?
  codigoAlfanumerico String      @unique
  estado             EstadoTurno @default(PENDIENTE)
  prioridad          Boolean     @default(false)
  horaLlamado        DateTime?
  horaFinalizacion   DateTime?
  creadoEn           DateTime    @default(now())

  // La posición en la fila se calcula en tiempo de consulta a partir de
  // creadoEn (ver ObtenerPosicionTurnoUseCase); no se persiste porque un
  // valor guardado queda desincronizado tras cancelaciones y es propenso
  // a duplicarse bajo creación concurrente.
  @@index([servicioId, estado])
  @@index([puntoId, estado])
}

enum EstadoTurno {
  PENDIENTE
  EN_CURSO
  ATENDIDO
  CANCELADO
}

// RF-06: catálogo de medicamentos (MEDICAMENTO en el modelo relacional
// completo, sección 15.1 de PROJECT_CONTEXT.md). Solo el catálogo y su
// disponibilidad por punto (Inventario); reserva (RF-07) queda para después.
model Medicamento {
  id                    String       @id @default(uuid())
  codigoNacional        String       @unique
  nombreGenerico        String
  concentracion         String
  presentacion          String
  laboratorioFabricante String
  requiereAutorizacion  Boolean      @default(false)
  creadoEn              DateTime     @default(now())
  inventario            Inventario[]
}

// Disponibilidad de un medicamento (por lote) en un punto de dispensación
// concreto. stockReservado queda en 0 hasta que se implemente RF-07
// (reserva de medicamentos) — el campo ya existe porque es parte del
// modelo de datos acordado desde el inicio del proyecto, no se inventa.
model Inventario {
  id                String            @id @default(uuid())
  puntoDispensacion PuntoDispensacion @relation(fields: [puntoId], references: [id])
  puntoId           String
  medicamento       Medicamento       @relation(fields: [medicamentoId], references: [id])
  medicamentoId     String
  lote              String
  stockActual       Int
  stockReservado    Int               @default(0)
  fechaVencimiento  DateTime
  creadoEn          DateTime          @default(now())

  @@unique([puntoId, medicamentoId, lote])
}

// RF-04: lista de espera por servicio+punto. A diferencia de Turno, una
// entrada acá no es un registro histórico que valga la pena conservar:
// o se promueve a un turno real (que sí queda en el historial), o el
// usuario se retira voluntariamente. Por eso sí se borra físicamente
// (ver ListaEsperaRepository.eliminar), a diferencia de los turnos que
// siempre se "cancelan" cambiando su estado.
model ListaEspera {
  id                String            @id @default(uuid())
  usuario           Usuario           @relation(fields: [usuarioId], references: [id])
  usuarioId         String
  servicio          Servicio          @relation(fields: [servicioId], references: [id])
  servicioId        String
  puntoDispensacion PuntoDispensacion @relation(fields: [puntoId], references: [id])
  puntoId           String
  creadoEn          DateTime          @default(now())

  @@unique([usuarioId, servicioId, puntoId])
  @@index([servicioId, puntoId])
}

// Bitácora de peticiones HTTP, persistida en base de datos (no solo en la
// consola del contenedor) para que sobreviva a un reinicio/redeploy y se
// pueda auditar/consultar después. usuarioId es intencionalmente un String
// suelto, sin relación: un log debe sobrevivir aunque el usuario que lo
// generó se borre más adelante.
model LogPeticion {
  id           String   @id @default(uuid())
  metodo       String
  ruta         String
  codigoEstado Int
  duracionMs   Int
  usuarioId    String?
  ip           String?
  mensaje      String?
  creadoEn     DateTime @default(now())

  @@index([creadoEn])
  @@index([codigoEstado])
}
